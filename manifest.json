{
  "schemaVersion": 1,
  "id": "omacodex.usage",
  "name": "Codex",
  "version": "1.0.0",
  "author": "omacodex",
  "license": "MIT",
  "description": "ChatGPT Codex subscription usage, quota windows and credits.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {"barWidget": "Main.qml"},
  "barWidget": {
    "displayName": "Codex",
