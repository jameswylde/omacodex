    "allowMultiple": false,
    "defaults": {"refreshIntervalSec": 300},
    "schema": [{"key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 60, "max": 3600, "step": 60, "defaultValue": 300}]
  }
}
